# Copy to .env and adjust for local development.
# Only public, client-safe values belong here — anything prefixed VITE_
# is bundled into client JS and is NOT a secret store.
# Never put API keys (e.g. Gemini/OpenAI) in VITE_* variables.

VITE_SITE_URL=https://hardcode.id
VITE_CONTACT_EMAIL=hello@hardcode.id
